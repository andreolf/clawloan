# ---- Database (Supabase Postgres) ----
# Supabase -> Settings -> Database -> Connection string -> URI
# After first `prisma db push`, run prisma/enable_rls.sql in the Supabase SQL editor.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---- WalletConnect ----
# Public project id from https://cloud.walletconnect.com (safe to expose client-side)
NEXT_PUBLIC_WC_PROJECT_ID="your_walletconnect_project_id"

# ---- Server-only secrets (never prefix with NEXT_PUBLIC) ----
# Shared secret required to trigger /api/sync (DB-mutating). Generate a long
# random value, e.g. `openssl rand -hex 32`. If unset, /api/sync returns 503.
# Callers must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate_a_long_random_secret"
